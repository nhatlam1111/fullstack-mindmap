{
  "name": "fullstack-mindmap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "validate": "tsx scripts/validate-content.ts",
    "content": "tsx scripts/build-content.ts",
    "test": "vitest run",
    "build": "npm run content && vite build && tsx scripts/to-artifact.ts",
    "e2e": "playwright test",
    "release": "tsx scripts/release.ts",
    "report": "tsx scripts/report.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "1.1.8",
    "@xyflow/react": "12.12.0",
    "minisearch": "7.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "gray-matter": "4.0.3",
    "jsdom": "26.1.0",
    "mdast-util-to-string": "4.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "6.4.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7",
    "yaml": "2.9.1"
  }
}
